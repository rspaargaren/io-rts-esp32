{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": false,
    "checkJs": false,
    "allowImportingTsExtensions": true,

    /* Preact Config */
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "skipLibCheck": true,
    "strict": true,
  },
  "include": ["node_modules/vite/client.d.ts", "**/*"]
}
